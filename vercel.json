{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "links.geminiautosaver.com" }],
      "destination": "https://gemini-link-tracker.lusayapatrick.workers.dev/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "links.geminiautosaver.com" }],
      "destination": "https://gemini-link-tracker.lusayapatrick.workers.dev/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/admin/analytics", "destination": "/api/admin/page" }
  ],
  "functions": {
    "api/admin/page.js": {
      "includeFiles": "lib/admin-analytics-page.html"
    }
  },
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
