# Lemon Squeezy webhook signing secret (needed only if that webhook is used)
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Polar webhook signing secret from Polar → Settings → Webhooks
POLAR_WEBHOOK_SECRET=

# Polar Organization Access Token (checkouts:write). Sandbox token for test.polar.sh.
POLAR_ACCESS_TOKEN=
# Leave unset to use https://sandbox-api.polar.sh. Set false for live api.polar.sh.
# POLAR_SANDBOX=false
# Optional. Product UUID. If empty, products are read from POLAR_CHECKOUT_LINK_ID.
# POLAR_CHECKOUT_LINK_ID=polar_cl_ntol2dKiRlYWabgQY2kXe4cF0NkBZ03XSpF8M0RMI0B
# POLAR_CHECKOUT_PRODUCT_ID=ec66c91f-852a-493f-b081-1ea10f8fe50a

# ECDSA P-256 PEM from gemini-auto-image-saver/keys/private.pem
# In Vercel, paste the full PEM. Replace real newlines with \n if the UI is one line.
LICENSE_PRIVATE_KEY=

# Resend API key. Test sending can use onboarding@resend.dev as the from address.
RESEND_API_KEY=
LICENSE_FROM_EMAIL=Gemini Auto Image Saver <onboarding@resend.dev>
SITE_URL=https://gemini-auto-saver.vercel.app

# Optional. Ignore orders for other products in the same store.
# LEMON_SQUEEZY_PRODUCT_ID=
# POLAR_PRODUCT_ID=

# Optional. Set to true after you leave Lemon Squeezy test mode.
# REQUIRE_LIVE_ORDERS=true

# Private /admin analytics (server-side only). Never prefix these with NEXT_PUBLIC_ / VITE_ / PUBLIC_
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ADMIN_ANALYTICS_PASSWORD=

# Google account + Pro entitlements (ours, not Polar). Leave empty while GOOGLE_AUTH is off.
# Neon/Postgres connection string. Webhooks write Pro here so Polar being down later does not matter.
DATABASE_URL=
# OAuth 2.0 Web client ID from Google Cloud. Must match js/site-config.js googleClientId.
GOOGLE_CLIENT_ID=
